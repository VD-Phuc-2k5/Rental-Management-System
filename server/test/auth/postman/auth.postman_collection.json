{
  "info": {
    "name": "Auth API Tests",
    "description": "Postman collection for Auth module test automation. Based on server/testing/auth.md\n\n## Usage\n1. Import this collection into Postman\n2. Import the environment file (auth.postman_environment.json)\n3. Select environment \"Auth API - Local\"\n4. Update {{base_url}} if needed\n5. Run requests in order or use Collection Runner with auth-test-data.json\n\n## OTP Handling\nRequests in \"Password Reset Flow\" folder set {{otp}} automatically via test endpoint.\nIf your server doesn't have GET /api/test/otp, manually set {{otp}} from Redis before running confirm-otp.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register Tenant (Setup)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `tenant-${Date.now()}@test.com`;",
                  "pm.environment.set('registered_email', email);",
                  "pm.variables.set('email', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register tenant - status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const userId = json.data.id;",
                  "pm.test('Response has data.id', () => {",
                  "  pm.expect(userId).to.be.a('string');",
                  "});",
                  "pm.test('Response has data.email', () => {",
                  "  pm.expect(json.data).to.have.property('email');",
                  "});",
                  "pm.test('Role is tenant', () => {",
                  "  pm.expect(json.data.role).to.eql('tenant');",
                  "});",
                  "const existingIds = pm.environment.get('created_user_ids');",
                  "pm.environment.set('created_user_ids', existingIds ? existingIds + ',' + userId : userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"fullName\": \"Nguyen Van A\",\n  \"phone\": \"091{{$timestamp}}\",\n  \"password\": \"{{test_password}}\",\n  \"confirm_password\": \"{{test_password}}\",\n  \"accepted_terms\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/user",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", "user"]
            }
          }
        },
